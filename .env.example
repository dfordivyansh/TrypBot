# Environment for convoapi. Never commit the real .env.
# DJANGO_DB_PATH=/home/ubuntu/app/db.sqlite3   (optional; defaults to ./db.sqlite3)
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=trypbot.duckdns.org,trypdeals.com,www.trypdeals.com,127.0.0.1,localhost
DJANGO_EXTRA_CSRF_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
DEEPSEEK_API_KEY=
GOOGLE_ADS_LEAD_WEBHOOK_KEY=
WEBSITE_BOOKING_WEBHOOK_KEY=
META_LEADS_VERIFY_TOKEN=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v22.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# 0 = no AI chat: one fixed reply, then the chat goes to a sales agent. 1 = AI bot replies.
WHATSAPP_AI_REPLIES=0
# Optional: your own fixed reply. In double quotes, \n starts a new line.
# WHATSAPP_AUTO_REPLY_TEXT="Thank you for contacting TrypDeals!\nOur travel expert will connect with you shortly."
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
