# /etc/systemd/system/convoapi.service
[Unit]
Description=convoapi (Django + Channels via Daphne)
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/app
EnvironmentFile=/home/ubuntu/app/.env
# FREE TIER (t3.small, 2GB RAM): Use 1 worker only
# FREE TIER (t3.micro, 1GB RAM): Use 1 worker only
# PAID TIER (t3.large, 8GB RAM): Use --workers 4 --threads 2
ExecStart=/home/ubuntu/app/.venv/bin/daphne -b 127.0.0.1 -p 8000 --workers 1 --threads 1 --timeout 300 --max-requests 1000 --max-requests-jitter 100 convoapi.asgi:application
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
